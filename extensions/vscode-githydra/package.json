{
    "name": "vscode-githydra",
    "displayName": "GitHydra",
    "description": "Comprehensive Git Automation with Beautiful UI",
    "version": "1.0.0",
    "publisher": "alqudimi",
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "SCM Providers",
        "Other"
    ],
    "activationEvents": [],
    "main": "./dist/extension.js",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "githydra-explorer",
                    "title": "GitHydra",
                    "icon": "media/logo.png"
                }
            ]
        },
        "views": {
            "githydra-explorer": [
                {
                    "id": "githydra-commands",
                    "name": "Operations"
                }
            ]
        },
        "commands": [
            {
                "command": "githydra.openDashboard",
                "title": "GitHydra: Open Dashboard",
                "icon": "$(dashboard)"
            },
            {
                "command": "githydra.status",
                "title": "GitHydra: View Status",
                "category": "GitHydra"
            },
            {
                "command": "githydra.sync",
                "title": "GitHydra: Sync (Push/Pull)",
                "category": "GitHydra"
            },
            {
                "command": "githydra.commit",
                "title": "GitHydra: Create Commit",
                "category": "GitHydra"
            },
            {
                "command": "githydra.branch",
                "title": "GitHydra: Manage Branches",
                "category": "GitHydra"
            },
            {
                "command": "githydra.log",
                "title": "GitHydra: View History",
                "category": "GitHydra"
            },
            {
                "command": "githydra.statistics",
                "title": "GitHydra: Repository Statistics",
                "category": "GitHydra"
            },
            {
                "command": "githydra.ai",
                "title": "GitHydra: AI Tools",
                "category": "GitHydra"
            },
            {
                "command": "githydra.web",
                "title": "GitHydra: Open Web Dashboard",
                "category": "GitHydra"
            },
            {
                "command": "githydra.stash",
                "title": "GitHydra: Stash Management",
                "category": "GitHydra"
            },
            {
                "command": "githydra.tag",
                "title": "GitHydra: Tag Management",
                "category": "GitHydra"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "githydra.openDashboard",
                    "when": "view == githydra-commands",
                    "group": "navigation"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src --ext ts",
        "test": "node ./out/test/runTest.js"
    },
    "devDependencies": {
        "@types/vscode": "^1.80.0",
        "@types/glob": "^8.1.0",
        "@types/mocha": "^10.0.1",
        "@types/node": "20.2.5",
        "@typescript-eslint/eslint-plugin": "^5.59.8",
        "@typescript-eslint/parser": "^5.59.8",
        "eslint": "^8.41.0",
        "glob": "^8.1.0",
        "mocha": "^10.2.0",
        "typescript": "^5.1.3",
        "@vscode/test-electron": "^2.3.2"
    }
}
